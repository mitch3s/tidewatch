{
  "name": "tidewatch",
  "version": "0.1.0",
  "private": true,
  "description": "An ambient aquarium for LG webOS TVs where you collect real fish species.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --trace off",
    "package:webos": "npm run build && node scripts/package-webos.mjs",
    "package:webos:dev": "npm run build:dev && node scripts/package-webos.mjs --dev",
    "build:dev": "tsc --noEmit && vite build --mode godmode"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@webos-tools/cli": "^3.2.6",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
